{
  "name": "yoletech",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "test": "playwright test",
    "contrast": "node --experimental-strip-types scripts/check-contrast.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "format": "prettier --write src scripts tests prisma/seed.ts *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/sora": "^5.2.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "vercel": "^59.23.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.9.7",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
